    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ── EDIT THIS CONFIG ONCE ─────────────────────────────────\nconst CONFIG = {\n  // Meta WhatsApp Business Cloud API\n  GRAPH_VERSION: 'v20.0',\n  PHONE_NUMBER_ID: 'paste-whatsapp-phone-number-id',\n  ACCESS_TOKEN: 'paste-permanent-access-token',\n  // Approved template names (create in Meta Business Manager)\n  TEMPLATES: {\n    confirmed: 'order_confirmed',\n    shipped: 'order_shipped',\n    out_for_delivery: 'delivery_today',\n    delivered: 'delivery_thanks',\n    cancelled: 'order_cancelled'\n  },\n  LANGS: {\n    confirmed: 'en_US',\n    shipped: 'en_US',\n    out_for_delivery: 'en',\n    delivered: 'en',\n    cancelled: 'en'\n  },\n  storeUrl: 'https://mediportbd.com'\n};\n// ──────────────────────────────────────────────────────────\nconst d = ($input.item.json.body && $input.item.json.body.data !== undefined ? $input.item.json.body.data : $input.item.json.data) || {};\n// Normalize BD phone to E.164 (01XXXXXXXXX -> 880XXXXXXXXX)\nlet phone = (d.customer?.phone || '').replace(/[^0-9]/g, '');\nif (phone.startsWith('880')) {\n  // already country code\n} else if (phone.startsWith('0')) {\n  phone = '880' + phone.slice(1);\n}\nreturn { json: { CONFIG, orderNumber: d.orderNumber, newStatus: d.newStatus, trackingNumber: d.tracking?.trackingNumber || null, courier: d.tracking?.courier || null, customerName: d.customer?.name || 'Customer', toPhone: phone } };"
      },
      "id": "code-normalize",
      "name": "Normalize + Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
