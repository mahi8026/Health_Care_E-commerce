{
  "name": "04 - B2B Quote Lead Routing",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "quote-created",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "wh-quote",
      "name": "Quote Created",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "mediport-quote-created"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ── EDIT THIS CONFIG ONCE ─────────────────────────────────\nconst CONFIG = {\n  telegramChatId: '-1001234567890',   // sales group\n  salesEmail: 'sales@mediportbd.com',\n  fromEmail: 'no-reply@mediportbd.com',\n  storeUrl: 'https://mediportbd.com'\n};\n// ──────────────────────────────────────────────────────────\nconst d = ($input.item.json.body && $input.item.json.body.data !== undefined ? $input.item.json.body.data : $input.item.json.data) || {};\nconst value = d.finalAmount || d.subtotal || 0;\n// Route by deal size — adjust tiers/owners to your team\nconst tier = value >= 100000 ? 'enterprise' : value >= 25000 ? 'growth' : 'standard';\nreturn { json: { CONFIG, quoteNumber: d.quoteNumber, value, tier, paymentTerms: d.paymentTerms, itemCount: d.itemCount, company: d.customer?.company || '-', contact: d.customer?.name || '-', email: d.customer?.email || '-', phone: d.customer?.phone || '-', b2bTier: d.customer?.b2bTier || '-' } };"
      },
      "id": "code-route",
      "name": "Route by Value",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const q = $input.first().json;\nconst emoji = q.tier === 'enterprise' ? '🏆' : q.tier === 'growth' ? '📈' : '📋';\nconst text = [\n  `${emoji} <b>NEW B2B QUOTE #${q.quoteNumber}</b> [${q.tier.toUpperCase()}]`,\n  ``,\n  `🏢 ${q.company} (${q.b2bTier})`,\n  `👤 ${q.contact} — ${q.phone} — ${q.email}`,,\n  `📦 ${q.itemCount} line item(s) • Terms: NET${q.paymentTerms}`,,\n  `💰 <b>৳${Number(q.value).toLocaleString()}</b>`,\n  ``,\n  `⚡ Respond within 24h SLA`\n].join('\\n');\nconst html = `\n  <h2>${emoji} New B2B Quote #${q.quoteNumber} (${q.tier})</h2>\n  <p><b>Company:</b> ${q.company} (${q.b2bTier})<br/>\n     <b>Contact:</b> ${q.contact} — ${q.phone} — ${q.email}<br/>\n     <b>Value:</b> ৳${Number(q.value).toLocaleString()} • NET${q.paymentTerms} • ${q.itemCount} items</p>\n  <p><a href=\"${q.CONFIG.storeUrl}/admin\">Open Admin Panel</a></p>`;\nreturn { json: { ...q, text, html } };"
      },
      "id": "code-format",
      "name": "Format Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $json.CONFIG.telegramChatId }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "id": "tg-sales",
      "name": "Telegram Sales",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [900, 180],
      "credentials": {
        "telegramApi": {
          "id": "mediport-tg",
          "name": "Mediport Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "={{ $json.CONFIG.fromEmail }}",
        "toEmail": "={{ $json.CONFIG.salesEmail }}",
        "subject": "=🏢 B2B Quote #{{ $json.quoteNumber }} — {{ $json.company }} — ৳{{ Number($json.value).toLocaleString() }} [{{ $json.tier }}]",
        "html": "={{ $json.html }}",
        "options": {}
      },
      "id": "mail-sales",
      "name": "Sales Rep Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [900, 380],
      "credentials": {
        "smtp": {
          "id": "mediport-smtp",
          "name": "Mediport SMTP"
        }
      }
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * *"
            }
          ]
        }
      },
      "id": "sched-sla",
      "name": "Daily SLA Sweep 10:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 700]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://host.docker.internal:5001/api/automation/quotes/stale?hours=24",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation-Key",
              "value": "paste-your-automation-api-key"
            }
          ]
        },
        "options": {}
      },
      "id": "http-stale",
      "name": "Get Stale Quotes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 700]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c-stale-count",
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-stale",
      "name": "Any Stale Quotes?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [680, 700]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $input.first().json;\nconst lines = (r.quotes || []).map(q => `• #${q.quoteNumber} — ${q.companyName || q.customer?.company || '-'} — ৳${Number(q.finalAmount || 0).toLocaleString()} (${Math.round((Date.now() - new Date(q.createdAt)) / 86400000)}d old)`).join('\\n');\nreturn { json: { text: `⏰ <b>QUOTE SLA BREACH</b>\\n\\n${r.count} quotation(s) awaiting response &gt;24h:\\n\\n${lines}` } };"
      },
      "id": "code-stale",
      "name": "Format Stale",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 700]
    },
    {
      "parameters": {
        "chatId": "-1001234567890",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "id": "tg-stale",
      "name": "SLA Reminder",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1120, 700],
      "credentials": {
        "telegramApi": {
          "id": "mediport-tg",
          "name": "Mediport Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "Quote Created": {
      "main": [
        [
          {
            "node": "Route by Value",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route by Value": {
      "main": [
        [
          {
            "node": "Format Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Lead": {
      "main": [
        [
          {
            "node": "Telegram Sales",
            "type": "main",
            "index": 0
          },
          {
            "node": "Sales Rep Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Daily SLA Sweep 10:00": {
      "main": [
        [
          {
            "node": "Get Stale Quotes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Stale Quotes": {
      "main": [
        [
          {
            "node": "Any Stale Quotes?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any Stale Quotes?": {
      "main": [
        [
          {
            "node": "Format Stale",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Stale": {
      "main": [
        [
          {
            "node": "SLA Reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {}
}
