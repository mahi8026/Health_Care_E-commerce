# ── n8n container config ─────────────────────────────────────────────
# NOTE: 5678 is often inside Windows/Hyper-V reserved port ranges.
# If "ports are not available" errors occur, pick a port outside the
# ranges listed by: netsh interface ipv4 show excludedportrange protocol=tcp
N8N_PORT=15678
N8N_HOST=localhost
N8N_PROTOCOL=http
# Public URL n8n uses to build webhook addresses.
# Local dev:  http://localhost:15678/
# Production: https://n8n.yourdomain.tld/
WEBHOOK_URL=http://localhost:15678/

# Login credentials for the n8n editor UI
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-strong-password

# Encrypts stored credentials. Generate once, NEVER lose it:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
N8N_ENCRYPTION_KEY=paste-generated-key-here

N8N_TRUST_PROXY=false
EXECUTIONS_DATA_MAX_AGE=168
TZ=Asia/Dhaka
GENERIC_TIMEZONE=Asia/Dhaka

# ── Shared secrets (must match backend .env) ─────────────────────────
# Backend sends this header on outbound events:  X-Webhook-Secret
N8N_WEBHOOK_SECRET=change-me-long-random
# Backend requires this header on /api/automation/* calls: X-Automation-Key
AUTOMATION_API_KEY=change-me-another-long-random
# Base URL of the running backend API (as reachable from the n8n container)
BACKEND_API_URL=http://host.docker.internal:5000
