# ============================================================================
# MedCore BD - Frontend Production Environment Variables
# ============================================================================
# IMPORTANT: Do NOT commit this file with real values to version control!
# Copy this to .env.production.local and fill in actual production values
# ============================================================================

# ── API Configuration ────────────────────────────────────────────────────────
# Your backend API URL (must include /api at the end)
NEXT_PUBLIC_API_URL=https://api.medcorebd.com/api

# ── Google Analytics ─────────────────────────────────────────────────────────
# Get your GA4 Measurement ID from: https://analytics.google.com/
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Site Configuration ───────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://medcorebd.com
NEXT_PUBLIC_SITE_NAME=MedCore BD
NEXT_PUBLIC_APP_NAME=MedCore BD

# ── Stripe Payment Gateway ───────────────────────────────────────────────────
# Get your publishable key from: https://dashboard.stripe.com/apikeys
# Use LIVE key (pk_live_...) for production, TEST key (pk_test_...) for staging
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_YOUR_LIVE_KEY

# ── Feature Flags ────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_STRIPE=true
NEXT_PUBLIC_ENABLE_BKASH=true
NEXT_PUBLIC_ENABLE_NAGAD=true
NEXT_PUBLIC_ENABLE_B2B_CREDIT=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# ── Optional: Error Tracking ─────────────────────────────────────────────────
# Sentry DSN for error tracking (optional)
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ── Optional: CDN Configuration ──────────────────────────────────────────────
# If using a CDN for static assets
# NEXT_PUBLIC_CDN_URL=https://cdn.medcorebd.com
