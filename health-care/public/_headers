# Cloudflare Pages custom headers
# These apply on top of what Next.js already sets via next.config.mjs
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# Long-lived cache for Next.js immutable static assets
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Static images in /public
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Security headers for all routes
/*
  X-DNS-Prefetch-Control: on
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
