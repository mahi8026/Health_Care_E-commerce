# ============================================================================
# MedCore BD Backend - Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env or .env.production to version control.
# ============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# Local MongoDB (development)
MONGODB_URI=mongodb://localhost:27017/medcore-bd

# MongoDB Atlas (production) — replace with your Atlas connection string
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/medcore-bd?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_EXPIRE=7d

# ── URLs ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000/admin
BACKEND_URL=http://localhost:5000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Option A — Gmail: use an App Password (not your login password)
#   myaccount.google.com → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM=MedCore BD <your-email@gmail.com>
ADMIN_EMAIL=admin@yourdomain.com

# ── Google OAuth ──────────────────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

# ── Stripe ────────────────────────────────────────────────────────────────────
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_STRIPE_PUBLISHABLE_KEY
# Webhook secret — run: stripe listen --forward-to localhost:5000/api/payments/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_WEBHOOK_SECRET

# ── Cloudinary ────────────────────────────────────────────────────────────────
# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=REPLACE_WITH_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_WITH_API_KEY
CLOUDINARY_API_SECRET=REPLACE_WITH_API_SECRET

# ── Redis ─────────────────────────────────────────────────────────────────────
# Leave empty to use in-memory fallback (development)
REDIS_URL=
# REDIS_URL=redis://default:<password>@<host>:<port>

# ── bKash Tokenized Checkout ──────────────────────────────────────────────────
# https://developer.bka.sh — Sandbox: https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=REPLACE_WITH_BKASH_APP_KEY
BKASH_APP_SECRET=REPLACE_WITH_BKASH_APP_SECRET
BKASH_USERNAME=REPLACE_WITH_BKASH_USERNAME
BKASH_PASSWORD=REPLACE_WITH_BKASH_PASSWORD
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_CALLBACK_URL=http://localhost:3000/payment/bkash/callback

# ── Nagad ─────────────────────────────────────────────────────────────────────
NAGAD_MERCHANT_ID=REPLACE_WITH_NAGAD_MERCHANT_ID
NAGAD_MERCHANT_KEY=REPLACE_WITH_NAGAD_MERCHANT_KEY
NAGAD_BASE_URL=https://sandbox.mynagad.com:10080/remote-payment-gateway-1.0

# ── Twilio (SMS) ──────────────────────────────────────────────────────────────
# https://console.twilio.com
TWILIO_ACCOUNT_SID=REPLACE_WITH_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=REPLACE_WITH_TWILIO_PHONE_NUMBER
