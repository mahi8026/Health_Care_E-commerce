# ============================================================================
# MedCore BD — Backend API Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values
# Required variables are marked with ✅
# Recommended variables are marked with ⚠️
# Optional variables are marked with ❌

# ── Server Configuration ─────────────────────────────────────────────────────
# ❌ Server port (default: 5000)
PORT=5001

# ✅ Environment: development, staging, production
NODE_ENV=development

# ── Database Configuration ───────────────────────────────────────────────────
# ✅ MongoDB connection string
# Local: mongodb://localhost:27017/medcore-bd
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/medcore-bd
MONGODB_URI=mongodb://localhost:27017/medcore-bd

# ── Authentication & Security ────────────────────────────────────────────────
# ✅ JWT secret for access tokens (minimum 32 characters)
# Generate: openssl rand -hex 64
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# ✅ JWT secret for refresh tokens (minimum 32 characters)
# Generate: openssl rand -hex 64
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars

# ❌ JWT access token expiration (default: 15m)
JWT_EXPIRE=7d

# ⚠️ CSRF secret for CSRF protection (minimum 32 characters)
# Generate: openssl rand -hex 64
CSRF_SECRET=your-csrf-secret-key-min-32-chars

# ── CORS Configuration ───────────────────────────────────────────────────────
# ✅ Frontend URL for CORS whitelist
CORS_ORIGIN=http://localhost:3000

# ✅ Frontend URL for redirects and email links
FRONTEND_URL=http://localhost:3000

# ⚠️ Admin dashboard URL
ADMIN_URL=http://localhost:3000/admin

# ── Rate Limiting ────────────────────────────────────────────────────────────
# ❌ Rate limit window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# ❌ Maximum requests per window (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# ── Email Configuration (SMTP) ───────────────────────────────────────────────
# ⚠️ SMTP host (leave empty to use Ethereal auto-account in development)
# Gmail: smtp.gmail.com
# SendGrid: smtp.sendgrid.net
# Mailgun: smtp.mailgun.org
SMTP_HOST=

# ⚠️ SMTP port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# ⚠️ SMTP username
# Gmail: your.email@gmail.com
# SendGrid: apikey
# Mailgun: postmaster@mg.yourdomain.com
SMTP_USER=

# ⚠️ SMTP password
# Gmail: App Password (not your login password) — get from myaccount.google.com
# SendGrid: Your SendGrid API key
# Mailgun: Your Mailgun SMTP password
SMTP_PASS=

# ⚠️ From email address
SMTP_FROM=MedCore BD <noreply@medcorebd.com>

# ⚠️ Admin email for notifications
ADMIN_EMAIL=admin@medcorebd.com

# ── Payment Gateway: bKash ───────────────────────────────────────────────────
# ⚠️ bKash Tokenized Checkout credentials
# Get from: https://developer.bka.sh
# Sandbox URL: https://tokenized.sandbox.bka.sh/v1.2.0-beta
# Live URL: https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_CALLBACK_URL=http://localhost:3000/payment/bkash/callback

# ── Payment Gateway: Nagad ───────────────────────────────────────────────────
# ❌ Nagad payment gateway credentials
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_KEY=
NAGAD_BASE_URL=https://sandbox.mynagad.com:10080/remote-payment-gateway-1.0

# ── Payment Gateway: SSL Commerz ─────────────────────────────────────────────
# ❌ SSL Commerz payment gateway credentials
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# ── Cloudinary (Image Uploads) ───────────────────────────────────────────────
# ⚠️ Cloudinary credentials for product image uploads
# Get from: https://cloudinary.com → Dashboard
# Free tier: 25 GB storage, 25 GB bandwidth/month
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── AWS S3 (Alternative to Cloudinary) ───────────────────────────────────────
# ❌ AWS S3 credentials (not implemented yet)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=medcorebd-assets

# ── SMS Service ──────────────────────────────────────────────────────────────
# ⚠️ SMS provider: 'twilio', 'ssl_wireless', 'mock'
# - twilio: Use Twilio (free $15 credit for testing)
# - ssl_wireless: Use SSL Wireless (paid, for production in Bangladesh)
# - mock: Development mode (logs SMS, doesn't send)
SMS_PROVIDER=mock

# Twilio Configuration
# Get from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SSL Wireless Configuration (for production in Bangladesh)
# Get from: https://sslwireless.com
SMS_API_KEY=
SMS_API_URL=https://smsplus.sslwireless.com/api/v3/send-sms
SMS_SENDER_ID=MedCoreBD

# ⚠️ Admin phone for SMS alerts
ADMIN_PHONE=+8801XXXXXXXXX

# ── Redis Cache ──────────────────────────────────────────────────────────────
# ⚠️ Redis connection for caching and rate limiting
# Local: localhost:6379
# Redis Cloud: Get from https://redis.com/try-free
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# ── reCAPTCHA v3 ─────────────────────────────────────────────────────────────
# ❌ Google reCAPTCHA v3 for bot protection
# Get from: https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_MIN_SCORE=0.5

# ── Two-Factor Authentication ────────────────────────────────────────────────
# ❌ App name shown in authenticator apps (Google Authenticator, Authy, etc.)
TWO_FACTOR_APP_NAME=MedCore BD

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# ⚠️ Google OAuth credentials for Google Sign-In
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BACKEND_URL=http://localhost:5001

# ── WhatsApp Business API ────────────────────────────────────────────────────
# ⚠️ WhatsApp automation for customer support and notifications
# Provider: 'meta' (Meta Cloud API), 'twilio' (Twilio), 'mock' (Development)
WHATSAPP_PROVIDER=mock
WHATSAPP_BUSINESS_PHONE=8801XXXXXXXXX

# Meta WhatsApp Cloud API (for production)
# Get from: https://developers.facebook.com/apps
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v18.0
WHATSAPP_VERIFY_TOKEN=

# WhatsApp Bot Configuration
WHATSAPP_BOT_ENABLED=true
WHATSAPP_AUTO_HANDOFF_THRESHOLD=5

# WhatsApp Notifications
WHATSAPP_NOTIFY_ORDER_CONFIRMATION=true
WHATSAPP_NOTIFY_ORDER_STATUS=true
WHATSAPP_NOTIFY_QUOTE_READY=true
WHATSAPP_NOTIFY_DELIVERY=true

# ── Error Tracking & Monitoring ──────────────────────────────────────────────
# ⚠️ Sentry DSN for backend error tracking
# Get from: https://sentry.io → Project Settings → Client Keys (DSN)
SENTRY_DSN=

# ❌ Sentry environment (development, staging, production)
SENTRY_ENVIRONMENT=development

# ❌ Sentry traces sample rate (0.0 to 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================================
# Security Best Practices:
# - Never commit .env to version control (add to .gitignore)
# - Use different secrets for development, staging, and production
# - Rotate secrets regularly (every 90 days recommended)
# - Use strong secrets (minimum 32 characters, generated with openssl rand -hex 64)
# - Restrict CORS_ORIGIN to your actual frontend domain in production
# - Enable 2FA for admin accounts
# - Use environment-specific Sentry projects
# - Keep Cloudinary and payment gateway credentials secure
# ============================================================================

# ============================================================================
# Quick Setup Commands:
# 
# Generate JWT secrets:
#   openssl rand -hex 64
# 
# Start local MongoDB:
#   mongod --dbpath /path/to/data
# 
# Start local Redis:
#   redis-server
# 
# Test email with Ethereal:
#   Leave SMTP_HOST empty, check logs for preview URL
# 
# Run database migrations:
#   npm run seed
# ============================================================================
