# =============================================================================
# MediportBD — Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env or any file containing real secrets to git.
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
ADMIN_URL=

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/mediportbd

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_64_char_hex_string
JWT_REFRESH_SECRET=change_me_to_a_different_random_64_char_hex_string
JWT_EXPIRE=7d

# ── CSRF ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 16
CSRF_SECRET=change_me_to_a_random_32_char_hex_string

# ── Google OAuth ─────────────────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (Brevo — recommended) ──────────────────────────────────────────────
# https://app.brevo.com → Settings → API Keys
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=MediportBD
ADMIN_EMAIL=admin@example.com

# ── reCAPTCHA ────────────────────────────────────────────────────────────────
# https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=
RECAPTCHA_THRESHOLD=0.5
# Set to 'true' to skip CAPTCHA verification in development only
SKIP_CAPTCHA_DEV=false

# ── Cloudinary — Image Uploads ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── bKash Payment ────────────────────────────────────────────────────────────
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_CALLBACK_URL=

# ── Nagad Payment ────────────────────────────────────────────────────────────
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_KEY=

# ── SSL Commerz ──────────────────────────────────────────────────────────────
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# ── SMS ──────────────────────────────────────────────────────────────────────
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMS_API_KEY=
SMS_SENDER_ID=MediportBD
ADMIN_PHONE=

# ── WhatsApp ─────────────────────────────────────────────────────────────────
WHATSAPP_PROVIDER=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change_me_verify_token
WHATSAPP_BUSINESS_PHONE=

# ── Redis Cache ──────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# ── Push Notifications ───────────────────────────────────────────────────────
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
VAPID_EMAIL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Sentry — Error Tracking ──────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# ── Two-Factor Auth ──────────────────────────────────────────────────────────
TWO_FACTOR_APP_NAME=MediportBD

# ── Seed Data Passwords (used by npm run seed) ───────────────────────────────
SEED_ADMIN_PASSWORD=Admin@123!
SEED_B2B_PASSWORD=B2B@Pass123
SEED_CUSTOMER_PASSWORD=Customer@123

# ── Error Detail ─────────────────────────────────────────────────────────────
# Set to 'true' to expose stack traces in API error responses (development only)
ERROR_DETAIL_ENABLED=true

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
