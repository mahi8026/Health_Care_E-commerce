# ============================================================================
# MedCore BD - Backend Environment Variables Template
# ============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env for development
# 2. Fill in the actual values (NEVER commit the filled .env file)
# 3. For production, set these in your hosting platform (Render, Railway, etc.)
# ============================================================================

# ── Server Configuration ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# ── Database ─────────────────────────────────────────────────────────────────
# Development: mongodb://localhost:27017/medcore-bd
# Production: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_URI=mongodb://localhost:27017/medcore-bd

# ── JWT Secrets ──────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate_a_random_64_byte_hex_string_here
JWT_REFRESH_SECRET=generate_another_random_64_byte_hex_string_here
JWT_EXPIRE=7d
CSRF_SECRET=generate_another_random_64_byte_hex_string_here

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
ADMIN_URL=http://localhost:3000/admin

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Gmail: smtp.gmail.com, port 587, use App Password
# SendGrid: smtp.sendgrid.net, port 587, user: apikey
# Mailgun: smtp.mailgun.org, port 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM=MedCore BD <noreply@medcorebd.com>
ADMIN_EMAIL=admin@medcorebd.com

# ── Stripe ───────────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ── bKash ────────────────────────────────────────────────────────────────────
# Get from: https://developer.bka.sh
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_CALLBACK_URL=http://localhost:3000/payment/bkash/callback

# ── Nagad ────────────────────────────────────────────────────────────────────
NAGAD_MERCHANT_ID=your_nagad_merchant_id
NAGAD_MERCHANT_KEY=your_nagad_merchant_key
NAGAD_BASE_URL=https://sandbox.mynagad.com:10080/remote-payment-gateway-1.0

# ── Cloudinary ───────────────────────────────────────────────────────────────
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── AWS S3 (Alternative to Cloudinary) ───────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=your-bucket-name

# ── SSL Commerz ──────────────────────────────────────────────────────────────
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_LIVE=false

# ── SMS Service ──────────────────────────────────────────────────────────────
# Options: 'twilio', 'ssl_wireless', 'mock'
SMS_PROVIDER=mock

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# SSL Wireless Configuration
SMS_API_KEY=your_sms_api_key
SMS_API_URL=https://smsplus.sslwireless.com/api/v3/send-sms
SMS_SENDER_ID=MedCoreBD

# Admin phone for alerts
ADMIN_PHONE=+8801XXXXXXXXX

# ── Redis Cache ──────────────────────────────────────────────────────────────
# Local: localhost, port 6379, no password
# Cloud: get from Redis Cloud dashboard
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# ── reCAPTCHA v3 ─────────────────────────────────────────────────────────────
# Get from: https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_MIN_SCORE=0.5

# ── Two-Factor Authentication ────────────────────────────────────────────────
TWO_FACTOR_APP_NAME=MedCore BD

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── File Upload ──────────────────────────────────────────────────────────────
MAX_FILE_SIZE=5242880

