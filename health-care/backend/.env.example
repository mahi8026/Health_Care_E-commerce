# ══════════════════════════════════════════════════════════════════════════════
# MedCore BD Backend Environment Variables Template
# ══════════════════════════════════════════════════════════════════════════════
# 
# ⚠️  SECURITY WARNING:
# - This is a TEMPLATE file with placeholder values
# - NEVER commit real credentials to version control
# - Copy this file to .env and replace all placeholder values
# - Add .env to .gitignore (already configured)
# 
# ══════════════════════════════════════════════════════════════════════════════

# ── Company Information ──────────────────────────────────────────────────────
COMPANY_NAME=MedCore BD
COMPANY_EMAIL=info@medcorebd.com
COMPANY_PHONE=+880 1800-000000
COMPANY_ADDRESS=Your Address Here

# ── Server Configuration ─────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── MongoDB Database ─────────────────────────────────────────────────────────
# Option 1: MongoDB Atlas (recommended for production)
# Get connection string from: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/medcore-bd?retryWrites=true&w=majority

# Option 2: Local MongoDB (development only)
# MONGODB_URI=mongodb://localhost:27017/medcore-bd

# ── JWT Authentication ───────────────────────────────────────────────────────
# ⚠️  CRITICAL: Generate new secrets using: node generate-secrets.js
# These secrets MUST be unique and kept confidential
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_64_BYTE_HEX_STRING
JWT_EXPIRE=7d
CSRF_SECRET=REPLACE_WITH_32_BYTE_HEX_STRING

# ── Admin Security ──────────────────────────────────────────────
ADMIN_SECRET=medcore-test-2026

# ── CORS & Frontend URLs ─────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000,https://yourdomain.vercel.app
FRONTEND_URL=https://yourdomain.vercel.app
ADMIN_URL=http://localhost:3000
BACKEND_URL=http://localhost:5001

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Email Service (SMTP) ─────────────────────────────────────────────────────
# Option 1: Gmail (for testing)
# Get App Password: https://myaccount.google.com → Security → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=MedCore BD <your.email@gmail.com>
EMAIL_FROM_NAME=MedCore BD
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@medcorebd.com
ADMIN_EMAIL=admin@medcorebd.com

# Option 2: SendGrid (recommended for production)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.your_sendgrid_api_key

# ── bKash Payment Gateway ────────────────────────────────────────────────────
# Get credentials from: https://developer.bka.sh
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_CALLBACK_URL=http://localhost:3000/payment/bkash/callback

# ── Nagad Payment Gateway ────────────────────────────────────────────────────
NAGAD_MERCHANT_ID=your_nagad_merchant_id
NAGAD_MERCHANT_KEY=your_nagad_merchant_key
NAGAD_BASE_URL=https://sandbox.mynagad.com:10080/remote-payment-gateway-1.0

# ── Cloudinary (Image Uploads) ───────────────────────────────────────────────
# Create free account: https://cloudinary.com
# Get credentials from Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── AWS S3 (Alternative to Cloudinary) ───────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=medcorebd-assets

# ── SSL Commerz Payment ──────────────────────────────────────────────────────
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_LIVE=false

# ── SMS Service ──────────────────────────────────────────────────────────────
SMS_PROVIDER=twilio

# Twilio Configuration
# Get free trial: https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_api_key_secret
TWILIO_PHONE_NUMBER=+1234567890

# SSL Wireless (Bangladesh)
SMS_API_KEY=your_sms_api_key
SMS_API_URL=https://smsplus.sslwireless.com/api/v3/send-sms
SMS_SENDER_ID=MedCoreBD
ADMIN_PHONE=+880XXXXXXXXXX

# ── Redis Cache ──────────────────────────────────────────────────────────────
# Option 1: Redis Cloud (recommended for production)
# Get free account: https://redis.com/try-free
REDIS_HOST=your-redis-host.cloud.redislabs.com
REDIS_PORT=12345
REDIS_PASSWORD=your_redis_password
REDIS_DB=0
REDIS_TTL=3600

# Option 2: Local Redis (development only)
# Install: brew install redis (macOS) or sudo apt install redis-server (Linux)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_TTL=3600

# ── reCAPTCHA v3 ─────────────────────────────────────────────────────────────
# Get keys from: https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_MIN_SCORE=0.5

# ── Two-Factor Authentication ────────────────────────────────────────────────
TWO_FACTOR_APP_NAME=MedCore BD

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Get credentials from: https://console.cloud.google.com
# Create OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# ── WhatsApp Business API ────────────────────────────────────────────────────
WHATSAPP_PROVIDER=mock
WHATSAPP_BUSINESS_PHONE=880XXXXXXXXX

# Meta WhatsApp Cloud API
# Get credentials from: https://developers.facebook.com/apps
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_API_VERSION=v18.0
WHATSAPP_VERIFY_TOKEN=your_verify_token

# WhatsApp Bot Configuration
WHATSAPP_BOT_ENABLED=true
WHATSAPP_AUTO_HANDOFF_THRESHOLD=5

# WhatsApp Notifications
WHATSAPP_NOTIFY_ORDER_CONFIRMATION=true
WHATSAPP_NOTIFY_ORDER_STATUS=true
WHATSAPP_NOTIFY_QUOTE_READY=true
WHATSAPP_NOTIFY_DELIVERY=true

# ══════════════════════════════════════════════════════════════════════════════
# END OF CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════
