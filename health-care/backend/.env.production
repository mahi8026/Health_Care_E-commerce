# Production Environment Variables for Render
# Configure these in Render Dashboard → Service → Environment

# Environment
NODE_ENV=production

# Server Configuration
# Render automatically provides PORT, but we set default
PORT=5000
# Update this after frontend deploys to Render
FRONTEND_URL=https://medcorebd-frontend.onrender.com

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/medcorebd?retryWrites=true&w=majority

# JWT Secrets (CHANGE THESE - Use 32+ character random strings)
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_32_CHAR_SECRET_KEY_FOR_PRODUCTION
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_SECURE_32_CHAR_REFRESH_SECRET


# Email Configuration (Production SMTP)
# Option 1: Gmail (Recommended for small scale)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# Option 2: SendGrid
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key

# Option 3: AWS SES
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=your-aws-smtp-username
# SMTP_PASS=your-aws-smtp-password

# Email From Address
EMAIL_FROM=noreply@medcorebd.com
EMAIL_FROM_NAME=MedCore BD

# CORS Origins (comma-separated)
# Default Render URLs:
CORS_ORIGINS=https://medcorebd-frontend.onrender.com
# With custom domain:
# CORS_ORIGINS=https://medcorebd.com,https://www.medcorebd.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=5242880

# Logging
LOG_LEVEL=info

# Payment Gateway (Future)
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_USERNAME=
# BKASH_PASSWORD=
# BKASH_BASE_URL=https://checkout.pay.bka.sh/v1.2.0-beta

# SSL Commerz (Future)
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=
# SSLCOMMERZ_IS_LIVE=true
