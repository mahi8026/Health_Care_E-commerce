{
  "name": "Mediport-backend",
  "version": "1.0.1",
  "description": "MediportBD Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node node_modules/nodemon/bin/nodemon.js src/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "seed": "node src/utils/seedData.js",
    "seed:whatsapp": "node scripts/seedWhatsApp.js",
    "fix:categories": "node src/scripts/fixProductCategories.js",
    "fix:brands": "node src/scripts/fixProductBrands.js",
    "fix:human-prices": "node src/scripts/fixHumanProductData.js",
    "generate-slugs": "node src/scripts/generateSlugs.js",
    "fix:slash-slugs": "node src/scripts/fixSlashSlugs.js",
    "verify-indexes": "node src/scripts/verifyIndexes.js",
    "diagnose": "node diagnose-connection.js",
    "restart": "powershell -ExecutionPolicy Bypass -File restart-server.ps1",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "load-test": "cd load-tests && artillery run basic-load-test.yml",
    "load-test:stress": "cd load-tests && artillery run stress-test.yml",
    "load-test:auth": "cd load-tests && artillery run authenticated-test.yml",
    "load-test:b2b": "cd load-tests && artillery run b2b-test.yml",
    "load-test:report": "cd load-tests && artillery run basic-load-test.yml --output report.json && artillery report report.json",
    "load-test:quick": "artillery quick --count 100 --num 10 http://localhost:5000/api/products",
    "load-test:create-users": "node load-tests/create-test-users.js",
    "load-test:diagnostic": "cd load-tests && artillery run diagnostic-test.yml",
    "scrape": "node scripts/scrape-products.js",
    "import:manual": "node scripts/manual-product-import.js",
    "import:healthway": "node scripts/scrape-healthway-tynor.js",
    "import:tynor-sample": "node scripts/import-tynor-sample.js",
    "import:auto": "node scripts/import-products-auto.js",
    "format:healthway": "node scripts/format-healthway-json.js",
    "fetch:healthway": "node scripts/fetch-healthway-tynor.js",
    "fetch:healthway-all": "node scripts/fetch-healthway-tynor.js --all",
    "upload:cloudinary": "node scripts/upload-images-to-cloudinary.js",
    "upload:cloudinary-tynor": "node scripts/upload-images-to-cloudinary.js --brand=Tynor",
    "upload:cloudinary-dry": "node scripts/upload-images-to-cloudinary.js --dry-run"
  },
  "keywords": [
    "medical",
    "ecommerce",
    "api"
  ],
  "author": "MediportBD",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@sentry/node": "^10.63.0",
    "@sentry/profiling-node": "^10.63.0",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "1.4.7",
    "cors": "^2.8.6",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.2",
    "helmet": "^7.2.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.0",
    "morgan": "^1.11.0",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^2.2.1",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.3.1",
    "resend": "^6.26.0",
    "slugify": "^1.6.9",
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "lint-staged": "^17.0.7",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
