# =============================================================================
# MediportBD — Production Backend Environment Template
# =============================================================================
# Copy to .env.production on your production server.
# NEVER commit this file or any file containing real secrets to git.
# =============================================================================

NODE_ENV=production
PORT=5000
FRONTEND_URL=https://your-frontend-domain.com
BACKEND_URL=https://your-backend-domain.com

MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/mediportbd

JWT_SECRET=generate_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=generate_a_different_one_with_openssl_rand_hex_32
CSRF_SECRET=generate_with_openssl_rand_hex_16

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RECAPTCHA_SECRET_KEY=

BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

SENTRY_DSN=

# ── Production-Specific ──────────────────────────────────────────────────────
ERROR_DETAIL_ENABLED=false
LOG_LEVEL=warn
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGINS=https://your-frontend-domain.com
