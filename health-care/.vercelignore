# Vercel Ignore File
# Files and directories to exclude from Vercel deployments

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage
*.test.js
*.test.jsx
*.spec.js
*.spec.jsx
__tests__
.jest

# Development
.env.local
.env.development
*.local

# Build artifacts (Vercel builds these)
.next
out
build
dist

# IDE
.vscode
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Git
.git
.gitignore

# Documentation (not needed for deployment)
*.md
!README.md

# Lighthouse
.lighthouseci
lighthouserc.js

# Backend (separate deployment)
backend

# Misc
.husky
