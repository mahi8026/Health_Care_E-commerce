{
  "name": "mediportbd",
  "version": "0.1.8",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-sitemap.js && next build",
    "build:sitemap": "node scripts/generate-sitemap.js",
    "start": "next start",
    "lint": "eslint --config eslint.config.mjs src/",
    "lint:fix": "eslint --config eslint.config.mjs src/ --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lighthouse": "lhci autorun",
    "analyze": "cross-env ANALYZE=true npm run build",
    "prepare": "node -e \"if (process.env.HUSKY === '0') process.exit(0)\" && husky || true"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.55.0",
    "autoprefixer": "^10.4.20",
    "date-fns": "^4.4.0",
    "next": "^16.2.6",
    "next-cloudinary": "^6.17.5",
    "next-pwa": "^5.6.0",
    "postcss": "^8.4.49",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-ga4": "^3.0.1",
    "react-icons": "^5.6.0",
    "react-onesignal": "^3.5.6",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^3.4.17",
    "uuid": "^14.0.1",
    "web-vitals": "5.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^20.5.3",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.2.6",
    "@opennextjs/cloudflare": "^1.20.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "cross-env": "^10.1.0",
    "eslint": "^10",
    "eslint-config-next": "16.2.12",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.0.7",
    "typescript": "^5.8.3",
    "wrangler": "^4"
  }
}
