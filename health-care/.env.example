# =============================================================================
# MediportBD — Frontend Environment Variables
# =============================================================================
# Copy this file to .env.local for development.
# NEVER commit .env.local or any file containing real secrets to git.
# =============================================================================

# ── API Configuration ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Cloudinary ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=mediportbd_products

# ── Analytics ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ── Sentry ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=

# ── Push Notifications (OneSignal) ───────────────────────────────────────────
NEXT_PUBLIC_ONESIGNAL_APP_ID=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── WhatsApp ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=8801XXXXXXXXX

# ── Feature Flags ────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_BKASH=true
NEXT_PUBLIC_ENABLE_B2B_CREDIT=true

# ── Dev Login (development only) ─────────────────────────────────────────────
NEXT_PUBLIC_DEV_LOGIN_EMAIL=admin@example.com
NEXT_PUBLIC_DEV_LOGIN_PASSWORD=
