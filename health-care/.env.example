# ============================================================================
# MedCore BD Frontend - Environment Variables Template
# ============================================================================
# Copy this file to .env.local for development
# Copy to .env.production.local for production
# NEVER commit .env.local or .env.production.local to version control!
# ============================================================================

# ── API Configuration ────────────────────────────────────────────────────────
# Backend API URL (must include /api at the end)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ── Stripe ───────────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
# Use test key (pk_test_...) for development
# Use live key (pk_live_...) for production
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# ── Google Analytics ─────────────────────────────────────────────────────────
# Get from: https://analytics.google.com/
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Site Configuration ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=MedCore BD
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=MedCore BD

# ── Feature Flags ────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_STRIPE=true
NEXT_PUBLIC_ENABLE_BKASH=true
NEXT_PUBLIC_ENABLE_NAGAD=true
NEXT_PUBLIC_ENABLE_B2B_CREDIT=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# ── Optional: Error Tracking ─────────────────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================================================
