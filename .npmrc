# Force legacy peer deps to avoid dependency resolution issues
legacy-peer-deps=true

# Optional dependencies MUST be installed — Next.js ships its SWC compiler as
# an optional platform-specific binary (@next/swc-win32-x64-msvc etc.).
# Without it, Jest aborts with "Failed to load bindings" on every suite.
# See RESPONSIVE_DESIGN_FIXES.md §7 for the investigation.

# Use production mode for builds
production=false

# Engine strict to enforce Node.js version
engine-strict=false
